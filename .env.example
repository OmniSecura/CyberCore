# ══════════════════════════════════════════════════════════════════════════════
#  CyberCore — environment variables
#  Copy this file to .env and fill in the values.
#  .env is listed in .gitignore and will NOT be committed.
# ══════════════════════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1

# ── MySQL ─────────────────────────────────────────────────────────────────────
DB_CONNECTOR=mysql
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_USER=root
MYSQL_PASSWORD=changeme_root
AUTH_USERNAME=root
AUTH_PASSWORD=changeme_root

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
MAIL_FROM=your@gmail.com
MAIL_FROM_NAME=CyberCore

# ── CORS / URLs ───────────────────────────────────────────────────────────────
# In production set this to your real domain, e.g. https://omnisecura.pl
ALLOWED_ORIGINS=http://localhost:80,http://localhost:3000
APP_URL=http://localhost

# ── Organization limits ───────────────────────────────────────────────────────
# Max active free-plan organizations a single user can own. Applies to creation
# and to ownership transfers (recipient is checked).
MAX_FREE_ORGS_PER_OWNER=3
