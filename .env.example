# ══════════════════════════════════════════════════════════════════════════════
#  CyberCore — environment variables
#  Copy this file to .env and fill in the values.
#  .env is listed in .gitignore and will NOT be committed.
# ══════════════════════════════════════════════════════════════════════════════

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_USER=cybercore
MYSQL_PASSWORD=changeme_app

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING

# ── Email (auth-service) ──────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@cybercore.dev
MAIL_USE_TLS=true

# ── Dashboard origin (for CORS) ───────────────────────────────────────────────
# In production set this to your real domain, e.g. https://app.cybercore.dev
ALLOWED_ORIGINS=http://localhost:80,http://localhost:3000
